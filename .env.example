# Example environment variables for Nexus project
# Rename this file to .env and fill in the values for your environment

# --- Service URLs ---
# The URL of the RAG service, as seen from the orchestrator
RAG_SERVICE_URL=http://rag_service:8002

# The URL of the orchestrator API, as seen from the frontend
NEXT_PUBLIC_API_URL=http://localhost:8001

# --- CORS ---
# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:3000

# --- LLM API Keys ---
# Add your API keys for the different LLM providers here.
# You only need to fill in the keys for the models you want to use.

# For OpenRouter models (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# For Google Gemini models (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# For Groq models (https://console.groq.com/keys)
GROQ_API_KEY=

# For OpenAI models (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# --- Ollama ---
# The URL for the Ollama service if you are running it.
# If using Docker, this should be http://host.docker.internal:11434
# to connect to Ollama running on your host machine.
OLLAMA_API_URL=http://localhost:11434

# --- Redis ---
# The URL for the Redis instance used for chat history
REDIS_URL=redis://localhost:6379/0